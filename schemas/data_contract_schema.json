{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://company.com/schemas/data-contract-v1.json",
  "title": "Data Contract Schema",
  "description": "Schema for validating Snowflake data contracts",
  "type": "object",
  "required": ["contract"],
  "properties": {
    "contract": {
      "type": "object",
      "required": ["id", "version", "producer", "schema", "sla", "governance"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+_v[0-9]+$",
          "description": "Unique contract identifier with version suffix"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "Semantic version (MAJOR.MINOR.PATCH)"
        },
        "status": {
          "type": "string",
          "enum": ["draft", "review", "approved", "active", "deprecated", "retired"],
          "default": "draft"
        },
        "producer": {
          "type": "object",
          "required": ["system", "team", "owner"],
          "properties": {
            "system": {
              "type": "string",
              "description": "Source system identifier"
            },
            "team": {
              "type": "string",
              "description": "Owning team name"
            },
            "owner": {
              "type": "string",
              "format": "email",
              "description": "Team contact email"
            },
            "slack_channel": {
              "type": "string",
              "pattern": "^#[a-z0-9-]+$"
            }
          }
        },
        "schema": {
          "type": "object",
          "required": ["database", "schema", "table", "columns"],
          "properties": {
            "database": {
              "type": "string",
              "description": "Target database (supports ${REGION} substitution)"
            },
            "schema": {
              "type": "string",
              "description": "Target schema"
            },
            "table": {
              "type": "string",
              "description": "Target table name"
            },
            "columns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/definitions/column"
              }
            }
          }
        },
        "sla": {
          "type": "object",
          "properties": {
            "freshness": {
              "type": "object",
              "properties": {
                "max_age_minutes": {
                  "type": "integer",
                  "minimum": 1
                },
                "measurement": {
                  "type": "string"
                }
              }
            },
            "completeness": {
              "type": "object",
              "properties": {
                "threshold_percent": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "critical_columns": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "availability": {
              "type": "object",
              "properties": {
                "uptime_percent": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "maintenance_window": {
                  "type": "string"
                }
              }
            },
            "volume": {
              "type": "object",
              "properties": {
                "expected_daily_rows": {
                  "type": "object",
                  "properties": {
                    "min": { "type": "integer" },
                    "max": { "type": "integer" }
                  }
                },
                "alert_on_variance_percent": {
                  "type": "number"
                }
              }
            }
          }
        },
        "quality_rules": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/quality_rule"
          }
        },
        "governance": {
          "type": "object",
          "required": ["classification", "ai_eligibility"],
          "properties": {
            "classification": {
              "type": "string",
              "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]
            },
            "residency_requirements": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "retention_days": {
              "type": "integer",
              "minimum": 1
            },
            "ai_eligibility": {
              "type": "string",
              "enum": ["TRUE", "FALSE", "PSEUDONYMIZED_ONLY", "AGGREGATED_ONLY"]
            }
          }
        },
        "lineage": {
          "type": "object",
          "properties": {
            "source_systems": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "connection": { "type": "string" },
                  "extraction": { "type": "string" }
                }
              }
            },
            "downstream_dependencies": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "contract_id": { "type": "string" },
                  "type": { "type": "string" }
                }
              }
            }
          }
        },
        "consumers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/consumer"
          }
        }
      }
    }
  },
  "definitions": {
    "column": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]*$"
        },
        "type": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["not_null", "unique", "primary_key", "foreign_key"]
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "pattern": { "type": "string" },
              "min": { "type": "number" },
              "max": { "type": "number" }
            }
          }
        },
        "tags": {
          "type": "object",
          "properties": {
            "DATA_CLASSIFICATION": {
              "type": "string",
              "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]
            },
            "PII_TYPE": {
              "type": "string",
              "enum": ["NONE", "LOW", "MODERATE", "HIGH"]
            },
            "AI_ALLOWED": {
              "type": "string",
              "enum": ["TRUE", "FALSE", "PSEUDONYMIZED_ONLY", "AGGREGATED_ONLY"]
            },
            "RESIDENCY_REGION": {
              "type": "string",
              "enum": ["GLOBAL", "ORIGIN", "EU_ONLY", "US_ONLY"]
            }
          },
          "required": ["DATA_CLASSIFICATION", "PII_TYPE", "AI_ALLOWED"]
        },
        "system_managed": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "quality_rule": {
      "type": "object",
      "required": ["id", "name", "type", "sql", "severity"],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": ["column_check", "table_check", "cross_table_check"]
        },
        "column": {
          "type": "string"
        },
        "sql": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": ["error", "warning", "info"]
        }
      }
    },
    "consumer": {
      "type": "object",
      "required": ["team", "contact", "use_case", "access_level"],
      "properties": {
        "team": {
          "type": "string"
        },
        "contact": {
          "type": "string",
          "format": "email"
        },
        "use_case": {
          "type": "string"
        },
        "access_level": {
          "type": "string",
          "enum": ["read_full", "read_masked", "read_aggregated"]
        }
      }
    }
  }
}
